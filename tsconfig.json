{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "node20",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["hardhat.config.ts", "test/**/*.ts", "artifacts/**/*.ts"]
}
